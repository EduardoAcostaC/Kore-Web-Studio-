# ==============================================================================
# CONFIGURACIÓN DE CORREO (GMAIL SMTP CON CONTRASEÑA DE APLICACIÓN)
# ==============================================================================
# Para enviar correos usando tu cuenta personal de Google:
# 1. Ve a https://myaccount.google.com/security y activa "Verificación en dos pasos".
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. En "Nombre de la app", escribe: Kore Web Studio y pulsa "Crear".
# 4. Google te generará una contraseña de 16 caracteres (ej: abcd efgh ijkl mnop).
# 5. Pégala aquí abajo en GMAIL_APP_PASSWORD sin espacios (ej: abcdefghijklmnop).
# ==============================================================================

# Tu correo de Gmail desde el que se enviará y que autentica el servicio
GMAIL_USER=tu_correo@gmail.com

# Tu contraseña de aplicación de 16 caracteres de Google (sin espacios)
GMAIL_APP_PASSWORD=abcdefghijklmnop

# (Opcional) Correo donde recibir las notificaciones si es diferente a GMAIL_USER
GMAIL_TO=tu_correo@gmail.com

# ==============================================================================
# CONFIGURACIÓN DE WHATSAPP DIRECTO
# ==============================================================================
# Número de teléfono de WhatsApp con código de país (ej: +52 55 1234 5678 o 525512345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=525512345678
